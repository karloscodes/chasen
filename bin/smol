#!/usr/bin/env bash
# A disposable Chasen server in a smolvm machine, for local tests.
#
#   bin/smol            create the machine, install the server built from this
#                       checkout, and print how to point the CLI at it
#
# The machine needs no sudo for its network and takes no port 80 or 443 on this
# computer, so it does not collide with other work. It has no systemd: the
# hardening step of the first-boot script is skipped, and this script starts
# Docker by hand.
set -euo pipefail
cd "$(dirname "$0")/.."

name=chasen-test
port=${SMOL_PORT:-18082}
domain=smol.localhost

# smolvm needs /dev/kvm. A user outside the kvm group borrows the group for the call.
smol() {
  if [ -w /dev/kvm ]; then smolvm "$@"; else sudo -n -u "$USER" -g kvm "$(command -v smolvm)" "$@"; fi
}
inside() { smol machine exec --name $name -- bash -c "$1"; }

# A running machine must stop before it can go.
remove() {
  smol machine stop --name $name >/dev/null 2>&1 || true
  smol machine delete --force --name $name >/dev/null 2>&1 || true
}

if [ "${1:-}" = "delete" ]; then
  remove
  exit 0
fi

remove
smol machine create --name $name --image ubuntu:24.04 --net --cpus 2 --mem 3072 --storage 20 -p "$port:80" >/dev/null
smol machine start --name $name >/dev/null

echo "Installing Docker in the machine..."
# The root of the machine is an overlay, and Docker cannot stack on it. /storage is ext4.
inside 'export DEBIAN_FRONTEND=noninteractive
apt-get update -qq >/dev/null && apt-get install -y -qq docker.io iptables curl ca-certificates >/dev/null 2>&1
mkdir -p /storage/docker
(dockerd --data-root /storage/docker >/var/log/dockerd.log 2>&1 &)
for i in $(seq 20); do docker info >/dev/null 2>&1 && exit 0; sleep 1; done
echo "Docker did not start" >&2; tail -5 /var/log/dockerd.log >&2; exit 1'

echo "Installing chasen-server from this checkout..."
mkdir -p tmp/smol
CGO_ENABLED=0 GOOS=linux go build -o tmp/smol/chasen-server ./cmd/chasen-server
smol machine cp tmp/smol/chasen-server $name:/usr/local/bin/chasen-server >/dev/null
inside "chmod +x /usr/local/bin/chasen-server && chasen-server setup --domain $domain >/var/log/setup.log 2>&1 || { tail -20 /var/log/setup.log; exit 1; }"

token=$(inside "sed -n 's/^token: //p' /etc/chasen/config.yml" | tr -d '"\r\n')
curl -fsS --retry 10 --retry-all-errors --retry-delay 1 -o /dev/null -H "Host: api.$domain" "http://127.0.0.1:$port/up"

cat <<DONE

The test server is ready. Point the CLI at it:

  export CHASEN_URL=http://api.$domain:$port CHASEN_TOKEN=$token

Then, in an app directory: chasen deploy
An app answers on: curl -H "Host: <app>.$domain" http://127.0.0.1:$port/
Remove the machine with: bin/smol delete
DONE
